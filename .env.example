##########################################
# CodePush Server — docker compose environment
# Copy to .env (chmod 600) and fill in before deploying.
##########################################

# ==============================
# Server (REQUIRED)
# ==============================
# Public URL of this server, as terminated by Nginx Proxy Manager.
SERVER_URL=https://codepush.example.com

# ==============================
# Authentication
# ==============================
# Interactive login provider for `code-push-standalone login`.
#   sso    -> VenusVerse SSO (OIDC, authorization_code + PKCE S256). Requires OIDC_* below.
#   <empty> -> built-in providers (GitHub/Microsoft, configured in api/.env.example)
AUTH_PROVIDER=sso

# --- VenusVerse SSO (required when AUTH_PROVIDER=sso) ---
# Issuer base URL; must expose /.well-known/openid-configuration reachable from the api container.
OIDC_ISSUER=https://sso.example.com
# Client registered in the SSO admin registry (confidential, skip_consent allowed).
OIDC_CLIENT_ID=codepush
OIDC_CLIENT_SECRET=
# Optional. Defaults to {SERVER_URL}/auth/callback/sso — must match the registered redirect_uri.
# OIDC_REDIRECT_URI=https://codepush.example.com/auth/callback/sso

# ==============================
# Storage (REQUIRED)
# ==============================
# Points at the `azurite` service in this stack. The devstoreaccount1 key is the
# well-known public Azurite development credential, not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# ==============================
# Optional
# ==============================
LOGGING=false
ENABLE_ACCOUNT_REGISTRATION=true
DISABLE_ACQUISITION=false
DISABLE_MANAGEMENT=false
UPLOAD_SIZE_LIMIT_MB=200
ENABLE_PACKAGE_DIFFING=false
# API_BIND_PORT=3010
